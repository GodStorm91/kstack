{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Promise", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@/*": [".cache/looseleaf/src/*"] }
  },
  "include": ["src"]
}
